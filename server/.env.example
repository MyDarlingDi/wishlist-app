# ---- required ----
BOT_TOKEN=                       # from @BotFather (after /revoke — see README, step 1)
WEBAPP_URL=https://wishlist-app-opal.vercel.app   # the Mini App (Vercel); also the only allowed CORS origin
DATABASE_URL=                    # postgres://user:pass@host/db?sslmode=require  (Neon / Supabase / Render Postgres)
AUTO_SETUP_BOT=1                 # on start, point the Telegram webhook + menu button at this server

# ---- screenshot recognition (either key is enough; without one, "upload a screenshot" answers 503) ----
ANTHROPIC_API_KEY=               # console.anthropic.com → API keys (default model: claude-opus-5)
OPENAI_API_KEY=                  # platform.openai.com → API keys (default model: gpt-5.6-luna)
# VISION_PROVIDER=openai         # only needed if BOTH keys are set and you want to force one
# VISION_MODEL=                  # override the provider's default model

# ---- optional ----
BOT_USERNAME=wish_and_gift_bot
APP_SHORT_NAME=wishlist          # Mini App short name from BotFather → share links open the app directly
PORT=3000

# ---- local development only (never in production) ----
# DEV_AUTH=1                     # accept "Authorization: dev <id>:<name>" instead of Telegram initData
# BOT_POLLING=1                  # receive updates by polling. DELETES THE BOT'S WEBHOOK — use a separate test bot!
