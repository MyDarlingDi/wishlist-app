{
  "name": "wishlist-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup:bot": "tsx --env-file-if-exists=.env src/scripts/setup-bot.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.3",
    "grammy": "^1.46.0",
    "openai": "^7.20.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
